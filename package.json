{
  "name": "website-messages",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "cf-typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "dev": "react-router dev",
    "db:migrate:local": "wrangler d1 migrations apply website-messages --local",
    "db:migrate:remote": "wrangler d1 migrations apply website-messages --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "react-router typegen && tsc -b"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260713.1",
    "@cloudflare/vite-plugin": "^1.66.0",
    "@react-router/dev": "^8.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.154.0"
  }
}
